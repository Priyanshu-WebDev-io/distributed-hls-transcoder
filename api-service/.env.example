PORT=3001

# PostgreSQL Database (Local Docker instance or Cloud provider)
DATABASE_URL=postgresql://video_user:video_password@localhost:5432/video_platform

# S3 / MinIO Storage Configuration
# Note: MinIO is used as a local development drop-in replacement for AWS S3.
# In production, replace with your AWS S3 bucket credentials & endpoint.
S3_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password
RAW_BUCKET=raw-videos
PUBLIC_BUCKET=public-videos

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Kafka Configuration
KAFKA_BROKER=localhost:29092
KAFKA_TOPIC=transcode-jobs
